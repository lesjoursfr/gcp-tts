{
	"name": "@lesjoursfr/gcp-tts",
	"version": "3.0.1",
	"description": "Wrapper around the Google Cloud TTS module.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lesjoursfr/gcp-tts.git"
	},
	"homepage": "https://github.com/lesjoursfr/gcp-tts#readme",
	"bugs": {
		"url": "https://github.com/lesjoursfr/gcp-tts/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": "22.x || 24.x || 26.x"
	},
	"keywords": [
		"tts",
		"gcp"
	],
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"type": "module",
	"scripts": {
		"freshlock": "rm -rf node_modules/ && rm .yarn/install-state.gz && rm yarn.lock && yarn",
		"update-voices": "TTS_GCP_CREDENTIALS=config/tts-gcp-credentials.json ts-node update-voices.ts",
		"eslint-check": "eslint",
		"eslint-fix": "eslint --fix",
		"prettier-check": "prettier --check .",
		"prettier-fix": "prettier --write .",
		"tsc-check": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"test": "NODE_OPTIONS='--loader=ts-node/esm' mocha"
	},
	"dependencies": {
		"@google-cloud/storage": "^7.22.0",
		"@google-cloud/text-to-speech": "^6.4.1",
		"debug": "^4.4.3",
		"fluent-ffmpeg": "^2.1.3",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@tsconfig/node22": "22.0.6",
		"@types/debug": "4.1.13",
		"@types/fluent-ffmpeg": "2.1.28",
		"@types/mocha": "10.0.10",
		"@types/node": "24.13.3",
		"eslint": "10.9.1",
		"eslint-config-prettier": "10.1.8",
		"globals": "17.11.0",
		"mocha": "11.8.0",
		"prettier": "3.9.6",
		"ts-node": "10.9.2",
		"typescript": "6.0.3",
		"typescript-eslint": "8.68.0"
	},
	"dependenciesMeta": {
		"protobufjs": {
			"built": true
		}
	},
	"packageManager": "yarn@4.18.0"
}
